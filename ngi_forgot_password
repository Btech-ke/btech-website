<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGI - Reset Password</title>
    <!-- Import Montserrat Font -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.8.0/firebase-auth-compat.js"></script>

    <style>
        :root {
            --bg-deep: #0B0E14;
            --surface-2: #151A23;
            --gold-500: #EAB308;
            --text-primary: #FFFFFF;
            --text-secondary: #94A3B8;
            --border-subtle: #1E293B;
            --error: #EF4444;
            --success: #22C55E;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Montserrat', sans-serif;
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-primary);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
        }

        /* Ambient Glow */
        .glow {
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(234, 179, 8, 0.15) 0%, rgba(11, 14, 20, 0) 70%);
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 0;
        }

        .card {
            background-color: var(--surface-2);
            border: 1px solid var(--border-subtle);
            border-radius: 24px;
            padding: 40px;
            width: 100%;
            max-width: 400px;
            z-index: 1;
            box-shadow: 0 20px 40px rgba(0,0,0,0.4);
            text-align: center;
        }

        .logo {
            width: 64px;
            height: 64px;
            background: linear-gradient(135deg, #FDE047 0%, #EAB308 100%);
            color: var(--bg-deep);
            border-radius: 16px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            font-weight: 700;
            margin: 0 auto 24px auto;
        }

        h2 {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        p {
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.5;
            margin-bottom: 32px;
        }

        .input-group {
            text-align: left;
            margin-bottom: 20px;
        }

        .input-group label {
            display: block;
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
            font-weight: 500;
            margin-left: 4px;
        }

        input {
            width: 100%;
            padding: 16px;
            background-color: var(--bg-deep);
            border: 1px solid var(--border-subtle);
            border-radius: 12px;
            color: var(--text-primary);
            font-size: 16px;
            outline: none;
            transition: all 0.3s ease;
        }

        input:focus {
            border-color: var(--gold-500);
            box-shadow: 0 0 0 2px rgba(234, 179, 8, 0.2);
        }

        button {
            width: 100%;
            padding: 18px;
            background-color: var(--gold-500);
            color: var(--bg-deep);
            border: none;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: opacity 0.3s ease;
            margin-top: 10px;
        }

        button:hover {
            opacity: 0.9;
        }

        button:disabled {
            background-color: var(--border-subtle);
            color: var(--text-secondary);
            cursor: not-allowed;
        }

        .message {
            margin-top: 20px;
            font-size: 14px;
            font-weight: 500;
            display: none;
        }

        .message.error {
            color: var(--error);
            display: block;
        }

        .message.success {
            color: var(--success);
            display: block;
        }

        #form-container, #error-container, #success-container {
            display: none;
        }
    </style>
</head>
<body>

    <div class="glow"></div>

    <div class="card">
        <div class="logo">N</div>
        
        <!-- INITIAL LOADING STATE -->
        <div id="loading-container" style="display: block;">
            <h2>Verifying Link...</h2>
            <p>Please wait while we securely verify your request.</p>
        </div>

        <!-- INVALID LINK STATE -->
        <div id="error-container">
            <h2>Link Expired</h2>
            <p>This password reset link is invalid or has already been used. Please request a new one from the NGI app.</p>
        </div>

        <!-- SUCCESS STATE -->
        <div id="success-container">
            <h2>Password Updated!</h2>
            <p style="color: var(--success); font-weight: 600;">Your password has been successfully reset.</p>
            <p>You can now close this window and log in to your NGI app with your new password.</p>
        </div>

        <!-- THE RESET FORM -->
        <div id="form-container">
            <h2>Reset Password</h2>
            <p>Enter a strong new password for your NGI account.</p>

            <div class="input-group">
                <label>New Password</label>
                <input type="password" id="new-password" placeholder="••••••••" required>
            </div>

            <div class="input-group">
                <label>Confirm Password</label>
                <input type="password" id="confirm-password" placeholder="••••••••" required>
            </div>

            <div id="alert-message" class="message"></div>

            <button id="submit-btn" onclick="handleReset()">Update Password</button>
        </div>
    </div>

    <script>
        // 🔥 REPLACE THIS WITH YOUR FIREBASE CONFIG 🔥
        const firebaseConfig = {
  apiKey: "AIzaSyCMJdzsgYU5KgJ0T-7JTKJTqnpvEaFB2Zs",
  authDomain: "n-g-i-761b1.firebaseapp.com",
  projectId: "n-g-i-761b1",
  storageBucket: "n-g-i-761b1.firebasestorage.app",
  messagingSenderId: "375248351958",
  appId: "1:375248351958:web:9b45197e1a1dadeaaa0f77",
  measurementId: "G-G36XSJ4DNQ"
};
        // Initialize Firebase
        firebase.initializeApp(firebaseConfig);
        const auth = firebase.auth();

        // Get the Action Code from the URL (Firebase adds this automatically to the email link)
        const urlParams = new URLSearchParams(window.location.search);
        const actionCode = urlParams.get('oobCode');
        const mode = urlParams.get('mode');

        const loadingDiv = document.getElementById('loading-container');
        const errorDiv = document.getElementById('error-container');
        const formDiv = document.getElementById('form-container');
        const successDiv = document.getElementById('success-container');
        const alertMessage = document.getElementById('alert-message');
        const btn = document.getElementById('submit-btn');

        // Verify the code as soon as the page loads
        if (mode === 'resetPassword' && actionCode) {
            auth.verifyPasswordResetCode(actionCode).then((email) => {
                // Code is valid! Show the form.
                loadingDiv.style.display = 'none';
                formDiv.style.display = 'block';
            }).catch((error) => {
                // Code is invalid or expired
                loadingDiv.style.display = 'none';
                errorDiv.style.display = 'block';
            });
        } else {
            loadingDiv.style.display = 'none';
            errorDiv.style.display = 'block';
        }

        // Handle the button click
        function handleReset() {
            const pass1 = document.getElementById('new-password').value;
            const pass2 = document.getElementById('confirm-password').value;

            if (pass1.length < 6) {
                showAlert("Password must be at least 6 characters long.", false);
                return;
            }

            if (pass1 !== pass2) {
                showAlert("Passwords do not match.", false);
                return;
            }

            btn.disabled = true;
            btn.innerText = "Updating...";

            auth.confirmPasswordReset(actionCode, pass1).then((resp) => {
                // Success!
                formDiv.style.display = 'none';
                successDiv.style.display = 'block';
            }).catch((error) => {
                // Error (e.g. weak password)
                btn.disabled = false;
                btn.innerText = "Update Password";
                showAlert(error.message, false);
            });
        }

        function showAlert(msg, isSuccess) {
            alertMessage.innerText = msg;
            alertMessage.className = isSuccess ? 'message success' : 'message error';
        }
    </script>
</body>
</html>
